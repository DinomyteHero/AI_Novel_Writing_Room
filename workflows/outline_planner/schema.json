{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OutlinePlannerArtifact",
  "description": "Output of the outline-planner surface. Carries the planner-level structural outline (Brooks four-part beat map), per-chapter outline entries, and the subplot/hook/revelation/promise/relationship/arc-phase-map skeletons. Per-scene cards live in scene-card-authoring; this artifact is outline-level only.",
  "type": "object",
  "required": ["outline"],
  "properties": {
    "surface": { "type": "string", "const": "outline-planner" },
    "schema_version": { "type": "string", "const": "1.0" },
    "structural_notes": {
      "type": "object",
      "properties": {
        "brooks_alignment": {
          "type": "object",
          "properties": {
            "part_1_setup": { "type": "string" },
            "inciting_incident": { "type": "string" },
            "first_plot_point": { "type": "string" },
            "part_2_response": { "type": "string" },
            "first_pinch_point": { "type": "string" },
            "midpoint": { "type": "string" },
            "part_3_attack": { "type": "string" },
            "second_pinch_point": { "type": "string" },
            "second_plot_point": { "type": "string" },
            "part_4_resolution": { "type": "string" },
            "climax": { "type": "string" }
          }
        }
      }
    },
    "outline": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["chapter_number", "synopsis"],
        "properties": {
          "chapter_number": { "type": "integer", "minimum": 1 },
          "chapter_title": { "type": "string" },
          "synopsis": { "type": "string" },
          "pov_character": { "type": "string" },
          "structural_phase": { "type": "string" },
          "arc_phases_active": {
            "type": "array",
            "items": { "type": "string" }
          },
          "subplot_ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "estimated_word_count": { "type": "integer" }
        }
      }
    },
    "subplots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["subplot_id"],
        "properties": {
          "subplot_id": { "type": "string" },
          "name": { "type": "string" },
          "function": { "type": "string" },
          "arc_summary": { "type": "string" },
          "chapters_active": {
            "type": "array",
            "items": { "type": "integer" }
          }
        }
      }
    },
    "hooks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["hook_id"],
        "properties": {
          "hook_id": { "type": "string" },
          "hook_type": {
            "type": "string",
            "enum": ["hard", "soft", "series"]
          },
          "planted_in": {
            "oneOf": [{ "type": "integer" }, { "type": "string" }]
          },
          "resolved_in": {
            "oneOf": [{ "type": "integer" }, { "type": "string" }]
          },
          "description": { "type": "string" }
        }
      }
    },
    "revelation_schedule": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "revelation_id": { "type": "string" },
          "info_id": { "type": "string" },
          "what": { "type": "string" },
          "content": { "type": "string" },
          "known_by": { "type": "array", "items": { "type": "string" } },
          "revealed_to": { "type": "array", "items": { "type": "string" } },
          "revealed_in": {
            "oneOf": [{ "type": "integer" }, { "type": "string" }]
          },
          "revealed_chapter": { "type": "integer" },
          "revealed_through_pov": { "type": "string" },
          "impact": { "type": "string" },
          "setup_required": { "type": "string" },
          "significance": {
            "type": "string",
            "enum": ["minor", "moderate", "major", "climactic"]
          }
        }
      }
    },
    "promise_payoff_ledger": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["promise_id", "promise", "type"],
        "properties": {
          "promise_id": { "type": "string" },
          "promise": { "type": "string" },
          "planted_in": {
            "oneOf": [{ "type": "integer" }, { "type": "string" }]
          },
          "payoff_in": {
            "oneOf": [{ "type": "integer" }, { "type": "string" }]
          },
          "type": {
            "type": "string",
            "enum": ["plot", "character", "thematic", "atmospheric"]
          },
          "related_hook_id": { "type": "string" }
        }
      }
    },
    "arc_phase_maps": {
      "type": "object",
      "description": "Per-character arc_phase_map keyed by character name, applied during compile to ensemble_cast[].weiland_arc.arc_phase_map.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": { "type": "string" }
      }
    }
  }
}
