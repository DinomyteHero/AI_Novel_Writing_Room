{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SceneCardAuthoringArtifact",
  "description": "Output of the scene-card-authoring surface. Wraps an array of scene cards plus optional structural_overrides for the translator. Each card mirrors schemas/scene_card.json. The bundle compiler writes these to data/franchises/<fr>/books/<bk>/scene_cards/chapter_NN_scene_NN.json after running them through workflows/_shared/scene_card_translator.translate_scene_card.",
  "type": "object",
  "required": ["scene_cards"],
  "properties": {
    "surface": { "type": "string", "const": "scene-card-authoring" },
    "schema_version": { "type": "string", "const": "1.0" },
    "structural_overrides": {
      "type": "object",
      "description": "Per-chapter structural_phase overrides keyed by chapter number (string or int).",
      "additionalProperties": {
        "type": "string",
        "enum": ["setup", "first_plot_point", "response", "first_pinch", "midpoint", "attack", "second_pinch", "second_plot_point", "resolution", "climax"]
      }
    },
    "scene_cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["chapter_number", "scene_number", "pov_character"],
        "properties": {
          "chapter_number": { "type": "integer", "minimum": 1 },
          "scene_number": { "type": "integer", "minimum": 1 },
          "structural_phase": {
            "type": "string",
            "enum": ["setup", "first_plot_point", "response", "first_pinch", "midpoint", "attack", "second_pinch", "second_plot_point", "resolution", "climax"]
          },
          "scene_type": { "type": "string", "enum": ["action", "sequel"] },
          "scene_role": {
            "type": "string",
            "enum": ["hook", "escalation", "reveal", "decision", "aftermath", "decision_and_plant"]
          },
          "pov_character": { "type": "string", "minLength": 1 },
          "mission": { "type": "string" },
          "scene_goal": { "type": "string" },
          "why_now": { "type": "string" },
          "opening_hook": { "type": "string" },
          "conflict": { "type": "string" },
          "scene_conflict": { "type": "string" },
          "conflict_type": { "type": "string", "enum": ["internal", "interpersonal", "external", "environmental"] },
          "dialogue_expectation": {
            "type": "string",
            "enum": ["dialogue_led", "balanced", "interior"]
          },
          "turning_point": { "type": "string" },
          "closing_hook": { "type": "string" },
          "characters_present": { "type": "array", "items": { "type": "string" } },
          "location": { "type": "string" },
          "setting": { "type": "string" },
          "sensory_details": { "type": "string" },
          "emotional_trajectory": { "type": "string" },
          "stakes": {
            "type": "object",
            "properties": {
              "personal": { "type": "string" },
              "interpersonal": { "type": "string" },
              "external": { "type": "string" }
            }
          },
          "plot_threads_advanced": { "type": "array", "items": { "type": "string" } },
          "promises_planted": { "type": "array", "items": { "type": "string" } },
          "promises_paid": { "type": "array", "items": { "type": "string" } },
          "canon_elements_needed": { "type": "array", "items": { "type": "string" } },
          "target_word_count": { "type": "integer" },
          "estimated_word_count": { "type": "integer" },
          "action_beats": {
            "type": "array",
            "items": { "type": "string" }
          },
          "notes": { "type": "string" },
          "time": { "type": "string" },
          "thematic_beat": { "type": "string" },
          "scene_outcome": { "type": "string" },
          "active_subplots": { "type": "array", "items": { "type": "string" } },
          "subplot_references": { "type": "array", "items": { "type": "string" } },
          "hook_actions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "hook_id": { "type": "string" },
                "action": { "type": "string", "enum": ["plant", "advance", "resolve", "subvert"] }
              }
            }
          },
          "hook_references": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "hook_id": { "type": "string" },
                "action": { "type": "string", "enum": ["plant", "advance", "resolve", "subvert"] }
              }
            }
          },
          "revelations": { "type": "array", "items": { "type": "string" } },
          "revelation_references": { "type": "array", "items": { "type": "string" } },
          "pov_arc_phase": { "type": "string" },
          "arc_phase": { "type": "string" },
          "arc_phase_transition": { "type": "string" }
        }
      }
    }
  }
}
