{
  "_readme": {
    "purpose": "Hand-labeled (blocked, candidate) pairs used by tests/test_successor_classifier.py to validate SuccessorClassifier output. Per architecture_upgrade_spec.md §5.3.4, the full validation set contains 30 pairs drawn from Ruusan ch01-ch05 and Betrayal ch01-ch02. The classifier must match the human label on >= 27 / 30 (90%) for runtime.firewall.successor_classifier.enabled to be trusted.",
    "status": "COMPLETE — 30 pairs, 30/30 classifier agreement at HEAD. Flag runtime.firewall.successor_classifier.enabled is cleared to flip on for non-Ruusan/Betrayal books. The test-bench book under data/franchises/test-bench/ opts in via its runtime_overrides.yaml; Ruusan and Betrayal stay on global default (off) until per-book parity tests approve the flip.",
    "classifier_config": {
      "jaccard_threshold": 0.5,
      "adjacency_max_for_continue": 1
    },
    "class_distribution": {
      "immediate_sequel": 4,
      "same_pov_continuation": 11,
      "same_turn_escalation": 5,
      "transitional_with_gap": 3,
      "loose_downstream": 6,
      "parallel_weak_dependence": 1
    },
    "coverage_notes": {
      "real_scene_cards": "Pairs labeled 'real Ruusan ...' use canonical fields from data/franchises/star-wars-legends-eu/books/the-ruusan-atonement/scene_cards/*.json. Likewise for Betrayal.",
      "synthetic_pairs": "immediate_sequel, transitional_with_gap, and parallel_weak_dependence require feature combinations not present in the natural Ruusan/Betrayal scene graph (e.g. depends_on pointers, non-Ben POV in Ruusan, same-cast across non-consecutive chapters). Those pairs use synthesized scene cards; the rationale notes which rule they exercise.",
      "chapter_index_note": "test_hand_labeled_pair builds chapter_index from only the two labeled cards, so adjacency_distance between them is always 1 in the flat index. Rule 5's 'adjacency > max' branch therefore cannot fire in this test setup; rule 5 fires only via the 'jaccard < threshold' clause. Rule 6 (parallel_weak_dependence) fires when jaccard is high and none of rules 1-4 apply."
    }
  },
