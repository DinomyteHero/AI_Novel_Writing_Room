# Copy to `.env` and fill in real values. The `.env` file is gitignored.

# Required for cloud / hybrid runs. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: only set if running a local llama-server backend. Default is
# http://127.0.0.1:8080/v1; override only if your server lives elsewhere.
# LLAMA_SERVER_BASE_URL=

# Optional: override the franchise/book if not passing them as CLI args.
# AI_NOVEL_FRANCHISE=
# AI_NOVEL_BOOK=
