# Copy to `.env` and fill in real values. The `.env` file is gitignored.
# The app's Settings page can also write these for you.

# Recommended: one key for every model. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: direct keys, if you'd rather use a provider's own API.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
