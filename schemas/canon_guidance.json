{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CanonGuidance",
  "description": "Static planning-time canon guidance sidecar produced by CanonScout and injected into chapter packets only when input_hash is fresh.",
  "type": "object",
  "required": [
    "schema_version",
    "scene_id",
    "chapter_number",
    "scene_number",
    "model",
    "prompt_version",
    "input_hash",
    "review_status",
    "confidence",
    "hard_constraints",
    "canon_risks",
    "legends_continuity_notes",
    "possible_disney_bleed",
    "required_context_for_drafter",
    "allowed_au_divergences",
    "open_questions"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "scene_id": { "type": "string", "pattern": "^ch[0-9]{2}_sc[0-9]{2}$" },
    "chapter_number": { "type": "integer", "minimum": 1 },
    "scene_number": { "type": "integer", "minimum": 1 },
    "model": { "type": "string" },
    "prompt_version": { "type": "string" },
    "input_hash": { "type": "string", "minLength": 32 },
    "review_status": {
      "type": "string",
      "enum": ["unreviewed", "accepted", "rejected", "needs_source"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "hard_constraints": { "$ref": "#/definitions/stringList" },
    "canon_risks": { "$ref": "#/definitions/stringList" },
    "legends_continuity_notes": { "$ref": "#/definitions/stringList" },
    "possible_disney_bleed": { "$ref": "#/definitions/stringList" },
    "required_context_for_drafter": { "$ref": "#/definitions/stringList" },
    "allowed_au_divergences": { "$ref": "#/definitions/stringList" },
    "open_questions": { "$ref": "#/definitions/stringList" }
  },
  "definitions": {
    "stringList": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
