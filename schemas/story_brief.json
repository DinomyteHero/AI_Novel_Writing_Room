{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StoryBrief",
  "description": "Author-owned planning model: confirmed/inferred claims plus open questions. Character, location, theme, plot, and voice sheets are projections of this file.",
  "type": "object",
  "required": ["schema_version", "project", "claims", "questions"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "project": {
      "type": "object",
      "required": ["title", "franchise"],
      "properties": {
        "title": { "type": "string" },
        "franchise": { "type": "string" }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim_id", "entity_type", "entity_id", "field", "value",
          "origin", "confidence", "status", "impact"
        ],
        "properties": {
          "claim_id": { "type": "string" },
          "entity_type": {
            "type": "string",
            "enum": ["intent", "character", "location", "theme", "plot", "world", "voice", "relationship"]
          },
          "entity_id": { "type": "string" },
          "field": { "type": "string" },
          "value": {},
          "origin": { "type": "string", "enum": ["author", "inferred", "delegated", "import"] },
          "confidence": { "type": "string", "enum": ["explicit", "inferred", "uncertain"] },
          "status": { "type": "string", "enum": ["proposed", "confirmed", "rejected", "superseded"] },
          "impact": { "type": "string", "enum": ["blocking", "strong", "texture"] },
          "source_quote": { "type": "string" },
          "created_at": { "type": "string" },
          "superseded_by": { "type": "string" },
          "delegated_rationale": { "type": "string" }
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question_id", "entity_type", "entity_id", "field", "question", "status"],
        "properties": {
          "question_id": { "type": "string" },
          "entity_type": { "type": "string" },
          "entity_id": { "type": "string" },
          "field": { "type": "string" },
          "question": { "type": "string" },
          "why_it_matters": { "type": "string" },
          "blocking": { "type": "boolean" },
          "status": { "type": "string", "enum": ["open", "resolved", "dropped"] }
        }
      }
    },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" }
  }
}
