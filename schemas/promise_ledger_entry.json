{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PromiseLedgerEntry",
  "description": "One row in the promise ledger (Slice 3). Declaration-driven: populated from planning artifacts and scene-card declarations. LLM inference does not change ledger entries in v1 \u2014 SceneReviewer progression suggestions land as revision debt, not ledger updates. See docs/architecture/architecture_upgrade_spec.md \u00a77.",
  "type": "object",
  "required": ["promise_id", "description", "setup_scene", "status"],
  "additionalProperties": false,
  "properties": {
    "promise_id": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "promise_type": {
      "type": "string",
      "enum": ["plot", "character", "thematic", "mystery", "romance", "other"]
    },
    "setup_scene": {
      "type": "string",
      "pattern": "^ch\\d{2}_sc\\d{2}$"
    },
    "payoff_scene": {
      "type": ["string", "null"],
      "pattern": "^ch\\d{2}_sc\\d{2}$"
    },
    "due_by_scene": {
      "type": ["string", "null"],
      "pattern": "^ch\\d{2}_sc\\d{2}$"
    },
    "status": {
      "type": "string",
      "enum": ["planted", "progressing", "paid", "broken", "retired"]
    },
    "progression_log": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scene_id", "source", "timestamp"],
        "additionalProperties": false,
        "properties": {
          "scene_id": { "type": "string", "pattern": "^ch\\d{2}_sc\\d{2}$" },
          "source": { "type": "string", "enum": ["scene_card", "manual", "planning"] },
          "note": { "type": "string" },
          "timestamp": { "type": "string", "format": "date-time" }
        }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
